# Source via DREAMDOJO_SITE_ENV=/absolute/path/site.env.
# Paths INSIDE the independent image; Slurm performs the host-to-container mounts.
# See CLUSTER.md and docker/dreamdojo/run_cluster.slurm.
export RLINF_PYTHON="/opt/venv/bin/python"
export DREAMDOJO_ROOT="/opt/src/DreamDojo"
export DREAMDOJO_DATA_ROOT="/assets/data"
# Checkpoints keep identical absolute paths on the host and inside the container.
export RLINF_CHECKPOINT_ROOT="/lustre/fsw/portfolios/healthcareeng/users/yunl/checkpoints"
export GR00T_MODEL_PATH="${RLINF_CHECKPOINT_ROOT}/gr00t_ft/g1_pick_trocar_head_10k_bs32_lr1e-4/976127"
export DREAMDOJO_WM_CHECKPOINT="${RLINF_CHECKPOINT_ROOT}/DreamDojo/lora_r32_lr3e-4_r64_18k/checkpoints/iter_000018000/model_ema_bf16.pt"
export DREAMDOJO_REWARD_CHECKPOINT="${RLINF_CHECKPOINT_ROOT}/reward/milestone_v2/best.pt"
export DREAMDOJO_LAM_CHECKPOINT="${RLINF_CHECKPOINT_ROOT}/DreamDojo/LAM_400k.ckpt"
export DREAMDOJO_ACTION_STATISTICS="${DREAMDOJO_ROOT}/shared_meta/G1_stats.json"
export HF_HOME="/cache/huggingface"

# HOST-side sbatch environment for the v1 image only (not a container path).
# Source/export before sbatch: the first v1 image omitted external/lam.
export DREAMDOJO_EXTERNAL_ROOT="/lustre/fsw/portfolios/healthcareeng/users/yunl/code/RLinf-runtime/20260911-lam-strict/external"

# Eight-GPU launch defaults: train env/global batch=64, eval slots=56.
# Larger per-iteration collection and global batch can be selected via CLI.
# This is NOT an instruction to access GPUs outside the Slurm allocation.
export DREAMDOJO_GPUS="0-7"
# Enable normal cluster P2P; only the faulty local host retains DISABLE=1.
# Explicit 0 also overrides the local fallback inside the original v1 image.
export NCCL_P2P_DISABLE=0
